 void wxFileDialog::GetFilenames(wxArrayString& files) const
 {
+    if ( m_nativeUsed )
+    {
+        files.Empty();
+        for ( const wxString& p : m_nativePaths )
+            files.Add(wxFileName(p).GetFullName());
+        return;
+    }
     m_fc.GetFilenames( files );
 }
 
 void wxFileDialog::GetPaths(wxArrayString& paths) const
 {
+    if ( m_nativeUsed )
+    {
+        paths = m_nativePaths;
+        return;
+    }
     m_fc.GetPaths( paths );
 }
 
