+int wxFileDialog::ShowNativeModal()
+{
+#if GTK_CHECK_VERSION(3,20,0)
+    GtkFileChooser* src = GTK_FILE_CHOOSER(m_widget);
+    GtkWindow* parent = gtk_window_get_transient_for(GTK_WINDOW(m_widget));
+    GtkFileChooserNative* native = gtk_file_chooser_native_new(
+        wxGTK_CONV(m_message), parent, gtk_file_chooser_get_action(src), NULL, NULL);
+    GtkFileChooser* dst = GTK_FILE_CHOOSER(native);
+    gtk_native_dialog_set_modal(GTK_NATIVE_DIALOG(native), TRUE);
+
+    gtk_file_chooser_set_select_multiple(dst, gtk_file_chooser_get_select_multiple(src));
+    gtk_file_chooser_set_do_overwrite_confirmation(dst, gtk_file_chooser_get_do_overwrite_confirmation(src));
+
+    // Filters: same objects and order, so filter indices stay valid.
+    GSList* filters = gtk_file_chooser_list_filters(src);
+    for ( GSList* it = filters; it; it = it->next )
+        gtk_file_chooser_add_filter(dst, GTK_FILE_FILTER(it->data));
+    g_slist_free(filters);
+    if ( GtkFileFilter* cur = gtk_file_chooser_get_filter(src) )
+        gtk_file_chooser_set_filter(dst, cur);
+
+    // Initial folder and name, as set up by Create() and the setters.
+    if ( !m_dir.empty() )
+        gtk_file_chooser_set_current_folder(dst, wxGTK_CONV_FN(m_dir));
+    if ( HasFlag(wxFD_SAVE) )
+    {
+        wxGtkString name(gtk_file_chooser_get_current_name(src));
+        if ( name && *name )
+            gtk_file_chooser_set_current_name(dst, name);
+        else if ( !m_fileName.empty() )
+            gtk_file_chooser_set_current_name(dst, wxGTK_CONV_FN(m_fileName));
+    }
+    else if ( !m_fileName.empty() && !m_dir.empty() )
+    {
+        gtk_file_chooser_set_filename(dst, wxGTK_CONV_FN(wxFileName(m_dir, m_fileName).GetFullPath()));
+    }
+
+    const gint res = gtk_native_dialog_run(GTK_NATIVE_DIALOG(native));
+
+    int ret = wxID_CANCEL;
+    if ( res == GTK_RESPONSE_ACCEPT )
+    {
+        m_nativePaths.clear();
+        GSList* files = gtk_file_chooser_get_filenames(dst);
+        for ( GSList* it = files; it; it = it->next )
+        {
+            m_nativePaths.Add(wxString::FromUTF8(static_cast<const char*>(it->data)));
+            g_free(it->data);
+        }
+        g_slist_free(files);
+
+        m_nativeFilterIndex = -1;
+        if ( GtkFileFilter* sel = gtk_file_chooser_get_filter(dst) )
+        {
+            GSList* list = gtk_file_chooser_list_filters(dst);
+            m_nativeFilterIndex = g_slist_index(list, sel);
+            g_slist_free(list);
+        }
+
+        if ( !m_nativePaths.empty() )
+        {
+            m_nativeUsed = true;
+            m_path = m_nativePaths[0];
+            m_dir = wxFileName(m_path).GetPath();
+            m_fileName = wxFileName(m_path).GetFullName();
+            if ( HasFlag(wxFD_CHANGE_DIR) && chdir(m_dir.fn_str()) != 0 )
+                wxLogSysError(_("Changing current directory to \"%s\" failed"), m_dir);
+            ret = wxID_OK;
+        }
+    }
+
+    g_object_unref(native);
+    SetReturnCode(ret);
+    return ret;
+#else
+    return wxID_CANCEL;
+#endif
+}
